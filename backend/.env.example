PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development
# Optional locally. MongoDB stores enquiries when configured; without it, development requests are saved to backend/data/inquiries.jsonl.
MONGODB_URI=
# Optional override for the local development enquiry file.
# INQUIRY_STORE_PATH=./data/inquiries.jsonl

# Admin dashboard (required in production; use a unique strong secret)
# ADMIN_DEV_PREVIEW=true enables a built-in local sign-in. Never set it on a live server.
ADMIN_DEV_PREVIEW=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Owner alerts (SMS + WhatsApp) via Twilio. Leave blank to turn off.
# Without these, visitors finish the enquiry with the WhatsApp button on the site.
OWNER_SMS_TO=
OWNER_WHATSAPP_TO=+918767613575
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
