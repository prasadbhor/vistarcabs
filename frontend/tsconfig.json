{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".codex-final-build-20261031/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".pw-browsers",
    ".npm-cache",
    "test-results",
    "playwright-report",
    "build-vistar",
    "vistar-release-final",
    ".codex-next-build",
    ".codex-next-phase5",
    ".codex-next-phase5b",
    ".codex-next-phase5c",
    ".codex-next-phase5d",
    ".codex-next-phase5e",
    ".codex-next-release"
  ]
}
