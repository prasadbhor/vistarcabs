{
  "name": "vista-cabs",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace frontend run dev",
    "dev:api": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build",
    "start:web": "npm --workspace frontend run start",
    "start:api": "npm --workspace backend run start",
    "check": "npm run build && npm run build:api",
    "build:api": "npm --workspace backend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
